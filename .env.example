# development | production (production refuses AUTH_MODE=dev and a plain-http PUBLIC_BASE_URL)
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://emailing:emailing@localhost:5432/gpc_emailing?sslmode=disable
# 32 random bytes, base64: seals the integration keys at rest and signs tracking links.
# openssl rand -base64 32. Losing or changing it means entering the keys again, and click links
# in mail already sent stop resolving.
SETTINGS_ENCRYPTION_KEY=
# Where the app lives. Open, click, unsubscribe and image links in e-mails point here, so keep
# it stable once mail has gone out.
PUBLIC_BASE_URL=http://localhost:8080
# Browser origins allowed to call the API (comma-separated). Defaults to PUBLIC_BASE_URL.
# ALLOWED_ORIGINS=http://localhost:8080
# keycloak (the default): staff sign in through the GrandPine staff realm; the client role
# (admin, editor, viewer) is the access level.
# dev: accept "dev:<uid>:<admin|editor|viewer>" bearer tokens — local only.
AUTH_MODE=dev
# KEYCLOAK_ISSUER=https://vf-iam-prod.grandpine.com/realms/gpc-staff
# KEYCLOAK_CLIENT_ID=emailing-staging
# KEYCLOAK_CLIENT_SECRET=
# Amazon SES. Credentials come from the environment (the ECS task role; locally AWS_PROFILE).
# Without SES_REGION and MAIL_FROM nothing is sent (dry-run mode still records campaigns).
# SES_REGION=ap-southeast-5
# MAIL_FROM=hello@grandpine.com           # default sender, on a verified SES identity
# SES_CONFIGURATION_SET=gpc-emailing-staging   # its events feed SES_EVENTS_QUEUE_URL
# SES_EVENTS_QUEUE_URL=https://sqs.ap-southeast-5.amazonaws.com/<account>/vf-emailing-staging-events
# Replies: every e-mail carries Reply-To name@REPLY_DOMAIN; SES receives that domain (MX to
# inbound-smtp.<region>.amazonaws.com), stores the mail in S3 and its S3 events feed this queue.
# The worker records the reply and forwards it to name@<the sending domain>.
# REPLY_DOMAIN=reply.grandpine.com
# SES_INBOUND_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/<account>/vf-emailing-staging-inbound
# How often the worker sends queued mail, reads the inbox and advances automations (it also
# runs straight after you send or activate something). WORKER_ENABLED=false for a read-only copy.
# WORKER_INTERVAL=5m
# WORKER_ENABLED=true
