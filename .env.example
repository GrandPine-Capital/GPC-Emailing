# Copy to .env (or export these variables). Everything here can also be
# changed later from the Settings page in the UI.

PORT=3000
# Public URL used in tracking pixels, click links and unsubscribe links.
BASE_URL=http://localhost:3000
DATABASE_PATH=./data/emailing.db

# Protect the dashboard & API with HTTP Basic auth (recommended in production).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Secret used to sign click-tracking links and the inbound reply webhook.
APP_SECRET=change-me

# Outgoing mail (SMTP). Leave SMTP_HOST empty to run in dry-run mode:
# emails are rendered and recorded but not actually delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_NAME=My Company
FROM_EMAIL=hello@example.com
REPLY_TO=

# Incoming mail (IMAP) for reply detection.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX

# Optional lead-finder portals.
HUNTER_API_KEY=
APOLLO_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
