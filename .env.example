# development | production (production refuses AUTH_MODE=dev and a plain-http PUBLIC_BASE_URL)
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://emailing:emailing@localhost:5432/gpc_emailing?sslmode=disable
# 32 random bytes, base64: seals the Gmail connection and integration keys at rest, and signs
# tracking links. openssl rand -base64 32. Losing or changing it means connecting Gmail and
# entering the keys again, and click links in mail already sent stop resolving.
SETTINGS_ENCRYPTION_KEY=
# Where the app lives. Open, click, unsubscribe and image links in e-mails point here, so keep
# it stable once mail has gone out.
PUBLIC_BASE_URL=http://localhost:8080
# Browser origins allowed to call the API (comma-separated). Defaults to PUBLIC_BASE_URL.
# ALLOWED_ORIGINS=http://localhost:8080
# keycloak (the default): staff sign in through the GrandPine staff realm; the client role
# (admin, editor, viewer) is the access level.
# dev: accept "dev:<uid>:<admin|editor|viewer>" bearer tokens — local only.
AUTH_MODE=dev
# KEYCLOAK_ISSUER=https://vf-iam-prod.grandpine.com/realms/gpc-staff
# KEYCLOAK_CLIENT_ID=emailing-staging
# KEYCLOAK_CLIENT_SECRET=
# The Google OAuth client (Google Cloud Console → APIs & Services → Credentials, type "Web
# application", Gmail API enabled) an admin connects the sending mailbox through. Authorised
# redirect URI: <PUBLIC_BASE_URL>/oauth/google/callback. Without it nothing is sent (dry-run
# mode still records campaigns).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# How often the worker sends queued mail, reads the inbox and advances automations (it also
# runs straight after you send or activate something). WORKER_ENABLED=false for a read-only copy.
# WORKER_INTERVAL=5m
# WORKER_ENABLED=true
