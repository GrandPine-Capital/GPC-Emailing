rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users are signed in (Google or email link) and listed in /admins/{email}
    // with role "owner", "admin" or "member". The Apps Script worker uses the
    // project owner's credentials and is not subject to these rules.
    function email() {
      return request.auth.token.email.lower();
    }
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function userDoc() {
      return /databases/$(database)/documents/admins/$(email());
    }
    function isMember() {
      return signedIn() && exists(userDoc());
    }
    // Docs created before roles existed have no role: treat them as owners.
    function isAdmin() {
      return isMember() && get(userDoc()).data.get('role', 'owner') in ['owner', 'admin'];
    }
    function isToken(t) {
      return t is string && t.matches('^[a-f0-9]{24}$');
    }

    // ---- day-to-day data: every user
    match /templates/{id} { allow read, write: if isMember(); }
    match /lists/{id} { allow read, write: if isMember(); }
    match /contacts/{id} { allow read, write: if isMember(); }
    match /campaigns/{id} { allow read, write: if isMember(); }
    match /messages/{id} { allow read, write: if isMember(); }
    match /automations/{id} { allow read, write: if isMember(); }
    match /runs/{id} { allow read, write: if isMember(); }
    match /replies/{id} { allow read, write: if isMember(); }
    match /whatsapp/{id} { allow read: if isMember(); }
    match /jobs/{id} { allow read, create: if isMember(); }
    match /stats/{id} { allow read: if isMember(); }
    match /meta/{id} { allow read, write: if isMember(); }
    match /leadSearches/{id} {
      allow read, write: if isMember();
      match /leads/{lead} { allow read, write: if isMember(); }
    }

    // ---- settings: everyone reads app/status/senders; only admins change them or see secrets
    match /settings/{id} {
      allow read: if isMember() && id != 'secrets' || isAdmin();
      allow write: if isAdmin();
    }

    // ---- team: admins manage users (nobody can remove or demote the owner);
    //      every user can read the team and their own entry.
    match /admins/{userEmail} {
      allow get: if signedIn() && email() == userEmail || isMember();
      allow list: if isMember();
      allow create: if isAdmin() && request.resource.data.role in ['admin', 'member'];
      allow update: if isAdmin() && resource.data.get('role', 'owner') != 'owner' && request.resource.data.role in ['admin', 'member'];
      allow delete: if isAdmin() && resource.data.get('role', 'owner') != 'owner' && userEmail != email();
    }

    // ---- public pages
    // Click-redirect page (r.html) resolves link keys created by the worker.
    match /links/{key} {
      allow get: if true;
      allow list: if isMember();
    }
    // Public pages record clicks and unsubscribe requests; the worker processes them.
    match /clicks/{id} {
      allow create: if request.resource.data.keys().hasOnly(['token', 'k', 'created_at'])
        && isToken(request.resource.data.token)
        && isToken(request.resource.data.k)
        && request.resource.data.created_at is string;
    }
    match /unsubscribes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['token', 'created_at'])
        && isToken(request.resource.data.token)
        && request.resource.data.created_at is string;
    }
  }
}
